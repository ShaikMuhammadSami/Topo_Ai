[Unit]
Description=Topo AI Infrastructure Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=topo-agent
Group=topo-agent

EnvironmentFile=-/etc/topo-agent/topo-agent.env

ExecStart=/usr/local/bin/topo-agent run

Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

ReadWritePaths=/var/lib/topo-agent

[Install]
WantedBy=multi-user.target