{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topo-ai.local/schemas/eval-runtime-causal-receipt-v2.json",
  "title": "Topo AI independent runtime causal receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment",
    "kubernetes",
    "ownership",
    "container",
    "deployment_status",
    "artifact_resolution",
    "observation",
    "ground_truth",
    "topo_used_to_construct_truth"
  ],
  "properties": {
    "schema_version": {"const": "eval-runtime-causal-receipt-v2"},
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "source_parent_commit", "source_failure_commit", "requested_artifact"],
      "properties": {
        "run_id": {"type": "integer", "minimum": 1},
        "source_parent_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_failure_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "requested_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["immutable_ref", "index_digest"],
          "properties": {
            "immutable_ref": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.-]*(?::[0-9]+)?/[^@\\s]+@sha256:[0-9a-f]{64}$"
            },
            "index_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      }
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "cluster", "namespace", "namespace_uid", "deployment_name", "deployment_uid", "replicaset_name", "replicaset_uid", "pod_name", "pod_uid"],
      "properties": {
        "context": {"type": "string", "minLength": 1},
        "cluster": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "pattern": "^topo-eval-lineage-causal-[1-9][0-9]*$"},
        "namespace_uid": {"type": "string", "minLength": 1},
        "deployment_name": {"const": "lineage-causal-fixture"},
        "deployment_uid": {"type": "string", "minLength": 1},
        "replicaset_name": {"type": "string", "minLength": 1},
        "replicaset_uid": {"type": "string", "minLength": 1},
        "pod_name": {"type": "string", "minLength": 1},
        "pod_uid": {"type": "string", "minLength": 1}
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaset_owner_deployment_uid", "pod_owner_replicaset_uid"],
      "properties": {
        "replicaset_owner_deployment_uid": {"type": "string", "minLength": 1},
        "pod_owner_replicaset_uid": {"type": "string", "minLength": 1}
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image", "image_id", "runtime_digest", "restart_count", "waiting_reason", "current_state", "last_termination_reason", "last_termination_exit_code", "last_termination_started_at", "last_termination_finished_at", "backoff_observation"],
      "properties": {
        "name": {"const": "fixture"},
        "image": {"type": "string", "minLength": 1},
        "image_id": {"type": "string", "minLength": 1},
        "runtime_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "restart_count": {"type": "integer", "minimum": 1},
        "waiting_reason": {"type": ["string", "null"]},
        "current_state": {"enum": ["waiting", "running", "terminated"]},
        "last_termination_reason": {"const": "Error"},
        "last_termination_exit_code": {"const": 42},
        "last_termination_started_at": {"type": "string", "format": "date-time"},
        "last_termination_finished_at": {"type": "string", "format": "date-time"},
        "backoff_observation": {"$ref": "#/$defs/backoff"}
      }
    },
    "deployment_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desired_replicas", "ready_replicas", "available_replicas", "unavailable_replicas"],
      "properties": {
        "desired_replicas": {"const": 1},
        "ready_replicas": {"const": 0},
        "available_replicas": {"const": 0},
        "unavailable_replicas": {"type": "integer", "minimum": 0}
      }
    },
    "artifact_resolution": {"$ref": "#/$defs/resolution"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "failure_confirmed_at", "captured_at", "timeout_seconds"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "failure_confirmed_at": {"type": "string", "format": "date-time"},
        "captured_at": {"type": "string", "format": "date-time"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120}
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_image_identity_confirmed", "ownership_chain_confirmed", "failure_mechanism_confirmed", "runtime_manifestation_confirmed", "operational_impact_confirmed"],
      "properties": {
        "exact_image_identity_confirmed": {"const": true},
        "ownership_chain_confirmed": {"const": true},
        "failure_mechanism_confirmed": {"const": true},
        "runtime_manifestation_confirmed": {"const": true},
        "operational_impact_confirmed": {"const": true}
      }
    },
    "topo_used_to_construct_truth": {"const": false}
  },
  "$defs": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "variant"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "variant": {"type": ["string", "null"]}
      }
    },
    "backoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reason", "event_uid", "event_count", "observed_at"],
      "properties": {
        "source": {"enum": ["container_status_waiting", "kubernetes_event"]},
        "reason": {"enum": ["BackOff", "CrashLoopBackOff"]},
        "event_uid": {"type": ["string", "null"]},
        "event_count": {"type": ["integer", "null"], "minimum": 1},
        "observed_at": {"type": ["string", "null"]}
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_version", "match_type", "requested_immutable_ref", "requested_index_digest", "runtime_image_id", "runtime_digest", "target_platform", "descriptor_digest", "descriptor_media_type", "descriptor_role", "descriptor_platform", "provider_verified", "provider_verification_source", "descriptor_relationship_verified", "executable_manifest", "accepted", "reason", "topo_output_used"],
      "properties": {
        "identity_version": {"const": "eval-oci-runtime-identity-v1"},
        "match_type": {"enum": ["EXACT_INDEX", "VERIFIED_PLATFORM_MANIFEST"]},
        "requested_immutable_ref": {"type": "string", "minLength": 1},
        "requested_index_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "runtime_image_id": {"type": "string", "minLength": 1},
        "runtime_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "target_platform": {"$ref": "#/$defs/platform"},
        "descriptor_digest": {"type": ["string", "null"]},
        "descriptor_media_type": {"type": ["string", "null"]},
        "descriptor_role": {"type": ["string", "null"]},
        "descriptor_platform": {"oneOf": [{"$ref": "#/$defs/platform"}, {"type": "null"}]},
        "provider_verified": {"type": ["boolean", "null"]},
        "provider_verification_source": {"type": ["string", "null"]},
        "descriptor_relationship_verified": {"type": "boolean"},
        "executable_manifest": {"type": "boolean"},
        "accepted": {"const": true},
        "reason": {"type": "string", "minLength": 1},
        "topo_output_used": {"const": false}
      }
    }
  }
}
