{
  "$id": "https://topoai.local/schemas/eval-1/evaluation-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "result_version": {"const": "eval-1.result.v1"},
    "harness_version": {"const": "eval-1.v1"},
    "evidence_semantics_version": {
      "enum": ["non-cause-evidence-v1", null]
    },
    "cause_fingerprint_version": {
      "enum": ["eval-cause-fingerprint-v1", null]
    },
    "cause_match_version": {
      "enum": ["eval-cause-match-v1", null]
    },
    "cause_match_status": {
      "enum": ["matched", "mismatched", "inconclusive", "not_applicable_abstention", "not_evaluated", null]
    },
    "expected_cause_fingerprints": {
      "items": {"$ref": "#/$defs/cause_fingerprint"},
      "type": "array"
    },
    "top1_actual_cause_fingerprint": {
      "anyOf": [{"$ref": "#/$defs/cause_fingerprint"}, {"type": "null"}]
    },
    "top1_cause_match": {
      "anyOf": [{"$ref": "#/$defs/cause_match_assessment"}, {"type": "null"}]
    },
    "top3_cause_matches": {
      "items": {"$ref": "#/$defs/cause_match_assessment"},
      "type": "array"
    },
    "cause_match_diagnostics": {"type": "object"},
    "run_id": {"minLength": 6, "type": "string"},
    "scenario_id": {"type": "string"},
    "topo_git_commit": {"minLength": 7, "type": "string"},
    "started_at": {"format": "date-time", "type": "string"},
    "completed_at": {"format": "date-time", "type": "string"},
    "environment": {"type": "object"},
    "ground_truth": {
      "properties": {
        "scenario_version": {"const": "eval-1.scenario.v1"},
        "scenario_id": {"type": "string"}
      },
      "required": ["scenario_version", "scenario_id"],
      "type": "object"
    },
    "execution_receipt": {"$ref": "#/$defs/execution_receipt"},
    "provider_verification": {"$ref": "#/$defs/provider_verification"},
    "topo_observation": {"$ref": "#/$defs/topo_observation"},
    "metric_results": {
      "additionalProperties": {"type": ["array", "boolean", "number", "integer", "null", "object"]},
      "type": "object"
    },
    "assertions": {"items": {"type": "object"}, "type": "array"},
    "failures": {"items": {"type": "object"}, "type": "array"},
    "warnings": {"items": {"type": "string"}, "type": "array"},
    "overall_status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "HARNESS_ERROR"]}
  },
  "required": [
    "result_version", "harness_version", "run_id", "scenario_id", "topo_git_commit",
    "started_at", "completed_at", "environment", "ground_truth", "execution_receipt",
    "provider_verification", "topo_observation", "metric_results", "assertions",
    "failures", "warnings", "overall_status"
  ],
  "title": "TopoAI EVAL-1 Result",
  "type": "object",
  "$defs": {
    "cause_comparison": {
      "additionalProperties": false,
      "properties": {
        "match_version": {"const": "eval-cause-match-v1"},
        "status": {
          "enum": [
            "exact", "compatible_partial", "insufficient_structure",
            "ambiguous", "value_mismatch",
            "entity_match_mutation_mismatch",
            "mutation_match_entity_mismatch", "different_cause"
          ]
        },
        "comparisons": {
          "additionalProperties": {
            "enum": ["matched", "mismatched", "not_comparable"]
          },
          "type": "object"
        },
        "compared_fields": {"items": {"type": "string"}, "type": "array"},
        "mismatched_fields": {"items": {"type": "string"}, "type": "array"},
        "unavailable_fields": {"items": {"type": "string"}, "type": "array"}
      },
      "required": [
        "match_version", "status", "comparisons", "compared_fields",
        "mismatched_fields", "unavailable_fields"
      ],
      "type": "object"
    },
    "cause_match_pair": {
      "additionalProperties": false,
      "properties": {
        "expected_cause_fingerprint": {"$ref": "#/$defs/cause_fingerprint"},
        "actual_cause_fingerprint": {"$ref": "#/$defs/cause_fingerprint"},
        "match": {"$ref": "#/$defs/cause_comparison"},
        "accepted": {"type": "boolean"}
      },
      "required": [
        "expected_cause_fingerprint", "actual_cause_fingerprint", "match",
        "accepted"
      ],
      "type": "object"
    },
    "cause_match_assessment": {
      "additionalProperties": false,
      "properties": {
        "cause_match_version": {"const": "eval-cause-match-v1"},
        "hypothesis_id": {"type": ["string", "null"]},
        "rank": {"type": ["integer", "null"]},
        "root_event_id": {"type": ["string", "null"]},
        "root_title": {"type": ["string", "null"]},
        "actual_event_resolution": {"type": "string"},
        "status": {
          "enum": [
            "exact", "compatible_partial", "insufficient_structure",
            "ambiguous", "value_mismatch",
            "entity_match_mutation_mismatch",
            "mutation_match_entity_mismatch", "different_cause"
          ]
        },
        "correct": {"type": ["boolean", "null"]},
        "reason": {"type": "string"},
        "actual_cause_fingerprint": {
          "anyOf": [{"$ref": "#/$defs/cause_fingerprint"}, {"type": "null"}]
        },
        "matched_expected_cause_fingerprint": {
          "anyOf": [{"$ref": "#/$defs/cause_fingerprint"}, {"type": "null"}]
        },
        "match": {
          "anyOf": [{"$ref": "#/$defs/cause_comparison"}, {"type": "null"}]
        },
        "all_matches": {
          "items": {"$ref": "#/$defs/cause_match_pair"},
          "type": "array"
        }
      },
      "required": [
        "cause_match_version", "hypothesis_id", "rank", "root_event_id",
        "root_title", "actual_event_resolution", "status", "correct",
        "reason", "actual_cause_fingerprint", "match", "all_matches"
      ],
      "type": "object"
    },
    "cause_fingerprint": {
      "additionalProperties": false,
      "properties": {
        "fingerprint_version": {"const": "eval-cause-fingerprint-v1"},
        "provider": {"type": ["string", "null"]},
        "entity_kind": {"type": ["string", "null"]},
        "canonical_entity_id": {"type": ["string", "null"]},
        "provider_native_entity_id": {"type": ["string", "null"]},
        "mutation_family": {"type": ["string", "null"]},
        "changed_field": {"type": ["string", "null"]},
        "before_value_ref": {},
        "before_value_hash": {"type": ["string", "null"]},
        "after_value_ref": {},
        "after_value_hash": {"type": ["string", "null"]},
        "initiating_event_id": {"type": ["string", "null"]},
        "source_change_id": {"type": ["string", "null"]},
        "scenario_logical_entity": {"type": ["string", "null"]},
        "scenario_logical_change": {"type": ["string", "null"]},
        "evidence_source": {"type": ["string", "null"]},
        "fingerprint_completeness": {"enum": ["complete", "partial", "insufficient_structure"]}
      },
      "required": [
        "fingerprint_version", "provider", "entity_kind", "canonical_entity_id",
        "provider_native_entity_id", "mutation_family", "changed_field",
        "before_value_ref", "before_value_hash", "after_value_ref", "after_value_hash",
        "initiating_event_id", "source_change_id", "scenario_logical_entity",
        "scenario_logical_change", "evidence_source", "fingerprint_completeness"
      ],
      "type": "object"
    },
    "execution_action": {
      "additionalProperties": false,
      "properties": {
        "action_id": {"type": "string"},
        "action_type": {"type": "string"},
        "logical_target": {"type": "string"},
        "provider_uid": {"type": "string"},
        "executed_at": {"format": "date-time", "type": "string"},
        "before": {"type": "object"},
        "after": {"type": "object"},
        "provider_receipt": {"type": "object"}
      },
      "required": ["action_id", "action_type", "logical_target", "provider_uid", "executed_at", "before", "after", "provider_receipt"],
      "type": "object"
    },
    "execution_receipt": {
      "additionalProperties": false,
      "properties": {
        "receipt_version": {"const": "eval-1.execution.v1"},
        "scenario_id": {"type": "string"},
        "run_id": {"type": "string"},
        "namespace": {"type": "string"},
        "started_at": {"format": "date-time", "type": "string"},
        "completed_at": {"format": "date-time", "type": ["string", "null"]},
        "actions": {"items": {"$ref": "#/$defs/execution_action"}, "type": "array"}
      },
      "required": ["receipt_version", "scenario_id", "run_id", "namespace", "started_at", "completed_at", "actions"],
      "type": "object"
    },
    "provider_object": {
      "additionalProperties": false,
      "properties": {
        "logical_name": {"type": "string"},
        "provider_kind": {"type": "string"},
        "namespace": {"type": "string"},
        "name": {"type": "string"},
        "uid": {"type": "string"},
        "observed_at": {"format": "date-time", "type": "string"},
        "spec": {"type": "object"},
        "status": {"type": "object"},
        "owner_uid": {"type": ["string", "null"]},
        "labels": {"type": "object"},
        "selectors": {"type": "object"}
      },
      "required": ["logical_name", "provider_kind", "namespace", "name", "uid", "observed_at", "spec", "status", "owner_uid", "labels", "selectors"],
      "type": "object"
    },
    "provider_verification": {
      "additionalProperties": false,
      "properties": {
        "verification_version": {"const": "eval-1.provider.v1"},
        "source": {"type": "string"},
        "observed_at": {"format": "date-time", "type": "string"},
        "established": {"type": "boolean"},
        "objects": {"items": {"$ref": "#/$defs/provider_object"}, "type": "array"},
        "assertions": {"items": {"type": "object"}, "type": "array"},
        "warnings": {"items": {"type": "string"}, "type": "array"}
      },
      "required": ["verification_version", "source", "observed_at", "established", "objects", "assertions", "warnings"],
      "type": "object"
    },
    "topo_observation": {
      "additionalProperties": false,
      "properties": {
        "observation_version": {"const": "eval-1.topo-observation.v1"},
        "captured_at": {"format": "date-time", "type": "string"},
        "incident": {"type": ["object", "null"]},
        "incident_candidates": {"items": {"type": "object"}, "type": "array"},
        "incident_signals": {"type": ["object", "null"]},
        "snapshot": {"type": ["object", "null"]},
        "causal_analysis": {"type": ["object", "null"]},
        "briefing": {"type": ["object", "null"]},
        "blast_radius": {"type": ["object", "null"]},
        "change_events": {"items": {"type": "object"}, "type": "array"},
        "incident_change_analysis": {"type": ["object", "null"]},
        "endpoint_statuses": {"type": "object"},
        "observed_times": {"type": "object"}
      },
      "required": ["observation_version", "captured_at", "incident", "incident_candidates", "incident_signals", "snapshot", "causal_analysis", "briefing", "blast_radius", "change_events", "incident_change_analysis", "endpoint_statuses", "observed_times"],
      "type": "object"
    }
  }
}
