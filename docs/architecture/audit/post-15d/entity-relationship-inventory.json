        "KubernetesCluster",
        "KubernetesNamespace",
        "KubernetesDeployment",
        "KubernetesReplicaSet",
        "KubernetesPod",
        "KubernetesService"
      ],
      "id_rule": "k8s:{safe_cluster}:{lower_kind}:{uid || namespace-or-_cluster:name}",
      "identity_strength": "UID is stable for object lifetime; fallback is scoped name but differs from agent hashing",
      "maturity": "PARTIAL",
      "stable_fields": [
        "cluster name",
        "Kubernetes UID when present"
      ],
      "ephemeral_fields": [
        "namespace/name fallback",
        "Pod name"
      ],
      "fallback_matching": "literal namespace-or-_cluster:name",
      "ambiguity_risks": [
        "fallback conflicts with agent and network-enricher formats",
        "Pod identity ends at object lifetime"
      ],
      "downstream_consumers": [
        "topology snapshots",
        "change correlation",
        "incident affected-entity resolution",
        "causal RCA",
        "blast radius",
        "ownership"
      ],
      "test_paths": [],
      "classification": "PARTIAL"
    },
