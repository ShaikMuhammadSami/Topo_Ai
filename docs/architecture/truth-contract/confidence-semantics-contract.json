{
  "schema_version": "1.0",
  "contract": "TC-5 confidence semantics and calibration boundaries",
  "confidence_semantics_version": "tc5.v1",
  "runtime_model": "app.models.confidence_semantics.CausalConfidenceSemantics",
  "runtime_owner": "app.services.confidence_semantics.ensure_analysis_confidence_semantics",
  "primary_algorithm_version": "13c-causal-v1",
  "causal_ranking": {
    "formula": "candidate_score*0.40 + topology_component*25 + temporal_component*15 + change_kind_prior*10 + lineage_component*10",
    "clip_range": [0, 100],
    "ranking_score_rounding": 2,
    "legacy_confidence_formula": "ranking_score / 100",
    "legacy_confidence_rounding": 4,
    "ranking_strength_thresholds": {"high_minimum": 0.75, "medium_minimum": 0.5, "low_below": 0.5},
    "probabilistic": false,
    "calibrated": false,
    "calibration_status": "not_calibrated",
    "calibrated_probability": null,
    "alternative_scores_form_distribution": false,
    "tc5_changes_weights_or_thresholds": false
  },
  "evidence_interpretation": {
    "count_source": "TC-4 CausalEvidenceLedger stance buckets",
    "counts_affect_ranking": false,
    "counts_affect_probability": false,
    "states": ["supported_under_current_model", "contested", "incomplete", "contested_with_gaps", "insufficient_evidence", "legacy_unknown"],
    "completeness": ["complete_for_current_model", "partial", "unknown"],
    "materiality_score_added": false
  },
  "score_concepts": [
    {"domain":"causal_rca","field":"CausalHypothesis.score","producer":"app.services.causal_rca.analyze_causal_rca","range":"0..100","semantic_type":"heuristic_ranking_score","probabilistic":false,"calibrated":false,"consumer":"13C ordering, API, briefing, CLI","display_rule":"numeric heuristic ranking score; never percent probability","compatibility_status":"preserved","model_version":"13c-causal-v1","known_limitations":"weighted source-authored heuristic without labeled calibration corpus"},
    {"domain":"causal_rca","field":"CausalHypothesis.confidence","producer":"app.services.causal_rca.analyze_causal_rca","range":"0..1","semantic_type":"legacy_normalized_heuristic_ranking_score","probabilistic":false,"calibrated":false,"consumer":"14B, 14E, dormant 14F, legacy API clients","display_rule":"legacy compatibility only; never percent confidence/probability","compatibility_status":"retained_and_explicitly_labeled","model_version":"13c-causal-v1","known_limitations":"name is historically misleading; equals score divided by 100"},
    {"domain":"causal_rca","field":"CausalHypothesis.confidence_level","producer":"app.services.causal_rca._confidence_level","range":"low|medium|high","semantic_type":"heuristic_ranking_band","probabilistic":false,"calibrated":false,"consumer":"API, response language, legacy UI","display_rule":"label as heuristic ranking band","compatibility_status":"preserved","model_version":"13c-causal-v1","known_limitations":"thresholds are policy heuristics, not empirical certainty bands"},
    {"domain":"causal_rca","field":"CausalHypothesis.confidence_semantics","producer":"app.services.confidence_semantics.causal_confidence_semantics","range":"typed object","semantic_type":"confidence_interpretation_contract","probabilistic":false,"calibrated":false,"consumer":"causal API and analysis persistence","display_rule":"authoritative interpretation metadata","compatibility_status":"additive_nullable_for_legacy","model_version":"tc5.v1","known_limitations":"legacy analyses without TC-4 ledger have unknown evidence completeness"},
    {"domain":"causal_rca","field":"CausalAnalysisResponse.confidence_semantics","producer":"app.services.confidence_semantics.ensure_analysis_confidence_semantics","range":"typed object","semantic_type":"top_hypothesis_or_insufficient_evidence_interpretation","probabilistic":false,"calibrated":false,"consumer":"causal-rca/latest and briefing","display_rule":"authoritative analysis-level semantics including null probability","compatibility_status":"additive_nullable_model_enriched_on_read","model_version":"tc5.v1","known_limitations":"does not create a hypothesis when evidence is insufficient"},
    {"domain":"causal_graph","field":"CausalEdge.confidence","producer":"app.services.causal_rca graph and lineage builders","range":"0..1","semantic_type":"edge_or_lineage_strength_heuristic","probabilistic":false,"calibrated":false,"consumer":"lineage ranking input and causal chain","display_rule":"edge score/strength, not causal probability","compatibility_status":"preserved","model_version":"13c-causal-v1","known_limitations":"meaning varies by causal edge type"},
    {"domain":"causal_graph","field":"CausalEvidenceItem.weight","producer":"app.services.causal_rca evidence builders","range":"0..1","semantic_type":"evidence_contribution_or_source_strength","probabilistic":false,"calibrated":false,"consumer":"causal graph and briefing evidence","display_rule":"evidence weight as decimal, not percent confidence","compatibility_status":"preserved","model_version":"13c-causal-v1","known_limitations":"not a universal evidence-quality metric"},
    {"domain":"causal_graph","field":"CausalChainStep.confidence_from_previous","producer":"app.services.causal_rca chain builder","range":"0..1|null","semantic_type":"copied_edge_strength","probabilistic":false,"calibrated":false,"consumer":"API and CLI causal chain","display_rule":"edge score, not probability","compatibility_status":"preserved","model_version":"13c-causal-v1","known_limitations":"inherits the source edge semantics"},
    {"domain":"change_intelligence","field":"IncidentChangeCandidate.score","producer":"app.services.incident_change_analysis.analyze_incident_change_events","range":"0..100","semantic_type":"deterministic_change_relevance_rank","probabilistic":false,"calibrated":false,"consumer":"13C candidate component and change API","display_rule":"change relevance score","compatibility_status":"preserved","model_version":"13a-existing","known_limitations":"source-authored time/entity/scope/risk weights"},
