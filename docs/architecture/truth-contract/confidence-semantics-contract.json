    {"domain":"incident_history","field":"SimilarityFactorScore.score","producer":"app.services.incident_similarity","range":"0..1|null","semantic_type":"exact_or_jaccard_feature_similarity","probabilistic":false,"calibrated":false,"consumer":"14D breakdown","display_rule":"factor similarity score","compatibility_status":"preserved","model_version":"14D-existing","known_limitations":"factor-specific overlap only"},
    {"domain":"response_intelligence","field":"HistoricalActionSupport.score","producer":"app.services.response_intelligence.historical_support_for_action","range":"0..1","semantic_type":"bounded_historical_support_index","probabilistic":false,"calibrated":false,"consumer":"14E and briefing remediation","display_rule":"historical support score with raw counts","compatibility_status":"preserved","model_version":"14E-existing","known_limitations":"small-sample capped; not action success probability"},
    {"domain":"response_intelligence","field":"CurrentEvidenceStrength","producer":"app.services.response_intelligence._current_evidence_strength","range":"low|moderate|high","semantic_type":"heuristic_policy_band","probabilistic":false,"calibrated":false,"consumer":"14E and dormant 14F","display_rule":"current evidence policy band","compatibility_status":"preserved","model_version":"14E-existing","known_limitations":"depends on legacy normalized causal rank and evidence-ID presence"},
    {"domain":"incident_outcome","field":"IncidentOutcome.rca_confidence","producer":"app.services.incident_outcome or responder override","range":"0..1","semantic_type":"outcome_verdict_support_marker","probabilistic":false,"calibrated":false,"consumer":"14C, 14D history, briefing outcome","display_rule":"outcome RCA support marker, separate from live causal rank","compatibility_status":"preserved","model_version":"14C-existing","known_limitations":"fixed verdict constants or responder-provided value"},
    {"domain":"legacy_response","field":"RemediationRecommendation.confidence","producer":"app.services.recommendation_engine","range":"0..1","semantic_type":"legacy_recommendation_heuristic_score","probabilistic":false,"calibrated":false,"consumer":"Advanced/manual response UI","display_rule":"legacy heuristic score as decimal","compatibility_status":"preserved_separate","model_version":"legacy recommendation algorithm","known_limitations":"not the 14B response-plan contract"},
    {"domain":"legacy_recovery","field":"RecoveryVerification.confidence","producer":"app.services.recovery_verification._verification_confidence","range":"0..1","semantic_type":"legacy_check_coverage_score","probabilistic":false,"calibrated":false,"consumer":"Advanced/manual recovery UI","display_rule":"check score as decimal","compatibility_status":"preserved_separate","model_version":"legacy recovery algorithm","known_limitations":"not recovery probability"},
    {"domain":"legacy_ai","field":"IncidentExplanation/InvestigationPlan/PostIncidentReport/Copilot confidence fields","producer":"legacy direct Groq paths or deterministic fallback","range":"0..1","semantic_type":"non_authoritative_generated_self_score","probabilistic":false,"calibrated":false,"consumer":"Advanced/manual AI UI","display_rule":"generated self-score, explicitly uncalibrated","compatibility_status":"preserved_separate","model_version":"provider/model-specific","known_limitations":"LLM-generated and never authoritative TC-5 input"},
    {"domain":"risk_and_priority","field":"predeployment risk_score, change risk_score, importance scores","producer":"domain-specific deterministic rules","range":"domain-specific bounded numeric or categorical","semantic_type":"risk_or_priority_index","probabilistic":false,"calibrated":false,"consumer":"change and predeployment views","display_rule":"risk/importance score, not probability or causal confidence","compatibility_status":"preserved_separate","model_version":"domain-specific","known_limitations":"not empirically calibrated incident likelihood"}
  ],
  "display_rules": {
    "prohibited": ["uncalibrated causal value formatted as percent confidence", "heuristic score labeled probability", "alternative ranks normalized into a probability distribution", "LLM-authored authoritative confidence"],
    "technical": "show heuristic ranking score/band, evidence state/completeness, and not-calibrated status",
    "business": "show evidence state and heuristic band; state that calibrated probability is unavailable",
    "cli": "show score semantics explicitly; preserve full JSON"
  },
  "future_calibration_requirements": ["labeled incidents with independently verified root causes", "representative source/scenario coverage", "train/calibration/held-out separation", "reliability analysis and calibration curves", "Brier score or equivalent proper scoring rule", "expected calibration error", "per-source and per-scenario calibration", "versioned algorithm/dataset/calibration procedure", "minimum sample requirements", "drift monitoring and out-of-scope withholding policy"],
  "prohibited_implementations": ["score divided by 100 labeled probability", "sigmoid or logistic transform without empirical calibration", "softmax normalization of alternative hypotheses", "evidence-count confidence arithmetic", "LLM scoring of authoritative causal fields"],
  "persistence": {"new_table": false, "new_analysis_payloads_embed_semantics": true, "legacy_rows_rewritten": false, "legacy_rows_enriched_in_memory": true},
  "historical_correctness": {"topology_selection_changed": false, "latest_snapshot_fallback_added": false},
  "llm_involvement": false
}
