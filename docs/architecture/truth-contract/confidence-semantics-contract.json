    {"domain":"topology","field":"Relationship.confidence","producer":"TC-2 graph linkers","range":"0..1|null","semantic_type":"inferred_relationship_heuristic_score","probabilistic":false,"calibrated":false,"consumer":"graph, RCA relationship evidence, code-to-runtime view","display_rule":"heuristic score only when confidence_semantics=heuristic_score; legacy 1.0 is not certainty","compatibility_status":"preserved_under_TC-2","model_version":"TC-2 linker-specific","known_limitations":"observed/declared/derived new edges omit numeric score; legacy edges are unspecified"},
    {"domain":"identity","field":"IdentityMember.confidence","producer":"app.services.identity_resolver","range":"0..1","semantic_type":"deterministic_identity_match_score","probabilistic":false,"calibrated":false,"consumer":"identity API and UI","display_rule":"match score as decimal","compatibility_status":"preserved","model_version":"legacy identity resolver","known_limitations":"fixed rule constants"},
    {"domain":"identity","field":"LogicalIdentity.confidence","producer":"app.services.identity_resolver","range":"0..1","semantic_type":"deterministic_group_identity_match_score","probabilistic":false,"calibrated":false,"consumer":"identity API and UI","display_rule":"match score as decimal","compatibility_status":"preserved","model_version":"legacy identity resolver","known_limitations":"not TC-1 canonical resolution probability"},
    {"domain":"ownership","field":"EntityOwnershipResolution.confidence","producer":"app.services.ownership_resolver.resolve_entity_ownership","range":"0..1","semantic_type":"ownership_mapping_specificity_score","probabilistic":false,"calibrated":false,"consumer":"14A, briefing, routing","display_rule":"ownership match specificity; never causal probability","compatibility_status":"preserved","model_version":"14A-existing","known_limitations":"current-state mapping and fixed precedence constants"},
    {"domain":"blast_radius","field":"BlastRadiusEntity.impact_score","producer":"app.services.blast_radius","range":"0..1","semantic_type":"graph_distance_impact_heuristic","probabilistic":false,"calibrated":false,"consumer":"blast API, business impact, briefing","display_rule":"impact score as decimal","compatibility_status":"preserved","model_version":"existing blast traversal","known_limitations":"undirected traversal is not confirmed impact probability"},
