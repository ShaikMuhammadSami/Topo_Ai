# Local Docker Compose demo only. The published ports stay on localhost.
TOPO_AUTH_MODE=development-disabled
TOPO_DATABASE_URL=sqlite:////opt/topo/data/topo.db
TOPO_SECRET_STORE_BACKEND=disabled
TOPO_BACKEND_URL=http://backend:8000
TOPO_BACKEND_PORT=8000
TOPO_FRONTEND_PORT=3000

# Optional: public GitHub repository enrichment. No token is needed for public repos.
TOPO_GITHUB_OWNER=
TOPO_GITHUB_REPO=
TOPO_GITHUB_API_URL=https://api.github.com
