TOPO_GITHUB_OWNER=your-github-owner
TOPO_GITHUB_REPO=your-repository

# Optional for public repositories.
# Required for most private repositories.
TOPO_GITHUB_TOKEN=

TOPO_GITHUB_API_URL=https://api.github.com
TOPO_GITHUB_API_VERSION=2026-03-10
TOPO_GITHUB_COMMIT_LIMIT=50
TOPO_GITHUB_TIMEOUT_SECONDS=20