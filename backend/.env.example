TOPO_GITHUB_OWNER=replace-with-github-owner
TOPO_GITHUB_REPO=replace-with-github-repository

# Public repositories may be queried without authentication. Configure private
# GitHub access through the installation SecretStore operator utility; runtime
# credential environment fallback is intentionally unsupported.
TOPO_INSTALLATION_ID=installation:replace-with-installation-uuid
TOPO_GITHUB_API_URL=https://api.github.com
TOPO_GITHUB_API_VERSION=2022-11-28
TOPO_GITHUB_COMMIT_LIMIT=100
TOPO_GITHUB_TIMEOUT_SECONDS=20
